<Window x:Class="DrawingReview.App.Views.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair pages" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Choose which old page is compared with which new page." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Old page"/>
                <ComboBox x:Name="OldPage"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="New page"/>
                <ComboBox x:Name="NewPage"/>
            </StackPanel>
        </Grid>
        <CheckBox x:Name="AddNew" Content="Add as a new pair (keep the current one)" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource TextButton}" MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
