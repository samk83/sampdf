<UserControl x:Class="DrawingReview.App.Views.SavedToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingReview.App.Core.ViewModels;assembly=DrawingReview.App.Core"
             x:Name="Root">
    <!-- DataContext: SavedToolsViewModel -->
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Tool set"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="+" ToolTip="New tool set" Command="{Binding AddSetCommand}" Margin="6,0,0,0"/>
            <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" DisplayMemberPath="Name"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Save selected markup as a tool"/>
                <TextBox x:Name="NewName" Margin="0,0,0,6" ToolTip="Tool name"/>
                <CheckBox x:Name="IncludeContent" Content="Include text and shape (not just style)" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TextButton}" Content="Save selected" Click="OnSaveSelected" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource TextButton}" Content="Import…" Click="OnImport" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource TextButton}" Content="Export…" Click="OnExport"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Tools}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SavedTool}">
                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="Click to use"
                            Command="{Binding DataContext.UseCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1E1F23" BorderBrush="#34363C" BorderThickness="1" CornerRadius="6" Padding="8,6" MinHeight="44">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,10,0" BorderThickness="2"
                                    BorderBrush="{Binding Style.StrokeColor, Converter={StaticResource RgbToBrush}}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="22" Height="22" ToolTip="Remove from set"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPath}" Width="9" Height="9" Data="{StaticResource IconClose}"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
