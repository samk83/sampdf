<Window x:Class="DrawingReview.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource TextButton}" MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
