<UserControl x:Class="DrawingReview.App.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingReview.App.Core.ViewModels;assembly=DrawingReview.App.Core">
    <!-- DataContext: SearchViewModel -->
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Find text"/>
        <TextBox x:Name="QueryBox" DockPanel.Dock="Top" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnQueryKey"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Style="{StaticResource PrimaryButton}" Content="Search" Command="{Binding SearchCommand}" Margin="0,0,6,0"/>
            <Button Style="{StaticResource TextButton}" Content="◀" ToolTip="Previous (Shift+Enter)" Command="{Binding PreviousCommand}" Margin="0,0,4,0"/>
            <Button Style="{StaticResource TextButton}" Content="▶" ToolTip="Next (Enter)" Command="{Binding NextCommand}" Margin="0,0,4,0"/>
            <Button Style="{StaticResource TextButton}" Content="Clear" Command="{Binding ClearCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SearchResult}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"><Run Text="Page "/><Run Text="{Binding PageCaption, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding Context}" Foreground="#C9CCD1" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
