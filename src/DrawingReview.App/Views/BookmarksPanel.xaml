<UserControl x:Class="DrawingReview.App.Views.BookmarksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:geo="clr-namespace:DrawingReview.Engine.Geometry;assembly=DrawingReview.Engine">
    <!-- DataContext: BookmarksViewModel -->
    <Grid Margin="6">
        <TextBlock Margin="6" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="This PDF has no bookmarks."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}"/>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type geo:OutlineItem}">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Tag="{Binding Level}" Loaded="OnItemLoaded"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
