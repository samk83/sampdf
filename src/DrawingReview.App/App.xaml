<Application x:Class="DrawingReview.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DrawingReview.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:RenderedImageConverter x:Key="ImageConverter"/>
            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisible"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisible"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToCollapsed" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
