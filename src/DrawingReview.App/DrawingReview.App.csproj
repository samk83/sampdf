<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Linux에서도 컴파일 확인을 할 수 있게 한다 (실행은 Windows에서만 가능). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DrawingReview</AssemblyName>
    <RootNamespace>DrawingReview.App</RootNamespace>
    <!-- 64비트 Windows용 네이티브 파일(PDFium·OpenCV)을 출력 폴더에 넣는다. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawingReview.App.Core\DrawingReview.App.Core.csproj" />
  </ItemGroup>

</Project>
