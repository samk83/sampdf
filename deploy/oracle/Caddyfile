# SITE_ADDRESS 예: 158-101-1-2.sslip.io (도메인이 없을 때, 서버 공인 IP의 점을 -로) 또는 drawings.example.com
{$SITE_ADDRESS} {
	# 나만 쓰기: 아이디·비밀번호를 물어본다. 로그인(Clerk)을 붙이기 전까지의 임시 잠금.
	basic_auth {
		{$LOGIN_USER} {$LOGIN_HASH}
	}
	encode gzip
	# 큰 도면 비교는 오래 걸릴 수 있어 응답을 10분까지 기다린다.
	reverse_proxy app:8080 {
		transport http {
			response_header_timeout 10m
		}
	}
}
